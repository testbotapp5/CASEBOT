# =============================================================================
# KINO BOT - ENVIRONMENT CONFIGURATION
# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring
# =============================================================================

# Majburiy: BotFather'dan olingan bot tokeni
BOT_TOKEN=

# Majburiy: Bosh administrator (Super Admin) Telegram ID raqami
SUPER_ADMIN_ID=

# Ixtiyoriy: Bot nomi (xabarlarda ishlatiladi)
BOT_NAME=Kino Bot

# Ixtiyoriy: Rivojlantiruvchi username (aloqa uchun, @ belgisiz)
DEVELOPER_USERNAME=

# =============================================================================
# MINI APP (Telegram Web App)
# =============================================================================

# 1-qadam: API_ENABLED=true qiling, bot ishga tushganda Mini App server ham
# ishga tushadi va /mnt/.../miniapp papkasidagi fayllarni + /api/* endpointlarni
# shu portda beradi.
API_ENABLED=false
API_PORT=3000

# 2-qadam: Serverni internetga chiqaring (masalan Nginx + SSL sertifikat bilan,
# yoki ngrok/Cloudflare Tunnel orqali vaqtinchalik test uchun), so'ng natijaviy
# HTTPS havolani shu yerga kiriting. Telegram Mini App FAQAT https:// havolalar
# bilan ishlaydi. Bo'sh qoldirilsa, asosiy menyuda "Mini App" tugmasi umuman
# ko'rsatilmaydi.
MINI_APP_URL=

# Ixtiyoriy: Flood himoyasi - 1 daqiqada ruxsat etilgan xabarlar soni
FLOOD_LIMIT=8

# Ixtiyoriy: Komandalar orasidagi minimal kutish vaqti (millisekund)
COOLDOWN_TIME=800

# Ixtiyoriy: Ishlash muhiti (production | development)
NODE_ENV=production

# Ixtiyoriy: Webhook orqali ishlatish uchun (bo'sh bo'lsa - polling ishlatiladi)
WEBHOOK_DOMAIN=
WEBHOOK_PORT=8443

